# Isi env vars ini di Vercel: Project -> Settings -> Environment Variables
# Jangan commit file .env asli ke git.

# Kunci rahasia yang disimpan di dalam QR code. Siapa pun yang scan QR
# dengan kunci yang cocok akan bisa MELIHAT buku kenangan (tidak bisa edit).
ACCESS_KEY=ganti-dengan-kata-rahasia-kalian

# Password untuk login sebagai admin. Admin bisa menambah, mengedit,
# menghapus kenangan, mengganti gambar "you + me", dan generate ulang QR.
ADMIN_PASSWORD=ganti-dengan-password-admin

# (Opsional) kunci untuk menandatangani cookie sesi. Kalau dikosongkan,
# otomatis memakai ADMIN_PASSWORD. Boleh diisi string acak apa saja.
SESSION_SECRET=ganti-dengan-string-acak-panjang
